REDIS_URL=redis://127.0.0.1:6379/0

# Reply generator: gemini | hf_api | local
GENERATION_PROVIDER=gemini

# --- Gemini (recommended) ---
# Free key: https://aistudio.google.com/apikey
# Prefer Flash only (gemini-flash-lite-latest). Non-flash names are ignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Gemini 3+ thinking: minimal (fast) | low | medium | high
GEMINI_THINKING_LEVEL=minimal
# Fail Gemini calls that hang (seconds)
GEMINI_TIMEOUT_SECONDS=18

# --- Hugging Face Inference API (no local GPU) ---
# Token: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_CHAT_MODEL=tanusrich/Mental_Health_Chatbot

# --- Local HF only if GENERATION_PROVIDER=local ---
CHATBOT_MODEL=tanusrich/Mental_Health_Chatbot
CHATBOT_FALLBACK_MODEL=google/flan-t5-base
CHATBOT_MAX_NEW_TOKENS=160

# Flask API port (macOS often occupies 5000)
PORT=5050

# Generation failover off by default (Flash-only). Set true to try hf_api after Gemini.
GENERATION_FAILOVER=false
FAILOVER_INCLUDE_LOCAL=false

# --- Memory ---
MEMORY_MAX_TURNS=40
MEMORY_SUMMARY_AFTER=12
MEMORY_KEEP_RECENT=8
# Optional Redis TTL seconds (0 = never expire)
MEMORY_TTL_SECONDS=0

# --- RAG retrieval ---
# embeddings (default) | token
RAG_BACKEND=embeddings
RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=2
RAG_MIN_SCORE=0.42
